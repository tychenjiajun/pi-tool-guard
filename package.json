{
  "name": "pi-tool-guard",
  "version": "0.6.2",
  "type": "module",
  "description": "Pi extension: runs an expensive bash command once and keeps its full log so the agent reads any slice instead of re-running, repairs LLM tool-call arguments (edit/write/read aliases plus trailing head/tail/grep pipeline extractors), and renames a misspelled tool call before pi dispatches it.",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./contract": "./contract.ts",
    "./contract.ts": "./contract.ts",
    "./pipeline": "./pipeline.ts",
    "./pipeline.ts": "./pipeline.ts",
    "./aliases": "./aliases.ts",
    "./aliases.ts": "./aliases.ts",
    "./names": "./names.ts",
    "./names.ts": "./names.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "llm",
    "ai-agent",
    "agentic-coding",
    "tool-calling",
    "tool-call-repair",
    "argument-normalization",
    "tool-name-repair",
    "bash",
    "shell",
    "pipeline",
    "output-projection",
    "context-window",
    "token-savings",
    "unbash",
    "sol-pi",
    "typescript"
  ],
  "author": "Jiajun Chen <tychenjiajun@live.cn>",
  "license": "MIT",
  "homepage": "https://pi.dev/packages/pi-tool-guard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tychenjiajun/pi-tool-guard.git"
  },
  "bugs": {
    "url": "https://github.com/tychenjiajun/pi-tool-guard/issues"
  },
  "sideEffects": false,
  "files": [
    "*.ts",
    "!*.test.ts",
    "README.md",
    "docs/**",
    "CONTEXT.md",
    "LICENSE",
    "assets/**"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/tychenjiajun/pi-tool-guard/main/assets/preview.png",
    "video": "https://raw.githubusercontent.com/tychenjiajun/pi-tool-guard/main/assets/demo.mp4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.2",
    "@earendil-works/pi-tui": ">=0.99.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "unbash": "^4.0.11"
  }
}
