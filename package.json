{
  "name": "pi-tool-guard",
  "version": "0.5.1",
  "type": "module",
  "description": "Pi extension that runs an expensive bash command once and keeps its full log on disk, so the agent reads any slice instead of re-running it — and repairs LLM tool calls: argument aliases for edit/write/read, plus trailing head/tail/grep pipeline projection.",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./contract": "./contract.ts",
    "./contract.ts": "./contract.ts",
    "./pipeline": "./pipeline.ts",
    "./pipeline.ts": "./pipeline.ts",
    "./aliases": "./aliases.ts",
    "./aliases.ts": "./aliases.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "llm",
    "ai-agent",
    "ai-agents",
    "ai-coding",
    "agentic-coding",
    "tool-calling",
    "tool-call-repair",
    "tool-override",
    "argument-normalization",
    "alias-correction",
    "bash",
    "shell",
    "pipeline",
    "pipeline-optimization",
    "output-projection",
    "output-truncation",
    "context-window",
    "context-savings",
    "token-savings",
    "head",
    "tail",
    "grep",
    "unbash",
    "sol-pi",
    "typescript",
    "developer-tools",
    "cli",
    "mcp"
  ],
  "author": "Jiajun Chen <tychenjiajun@live.cn>",
  "license": "MIT",
  "homepage": "https://www.npmjs.com/package/pi-tool-guard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tychenjiajun/pi-tool-guard.git"
  },
  "bugs": {
    "url": "https://github.com/tychenjiajun/pi-tool-guard/issues"
  },
  "sideEffects": false,
  "files": [
    "*.ts",
    "!*.test.ts",
    "README.md",
    "README.zh-CN.md",
    "CONTEXT.md",
    "LICENSE",
    "assets/**"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "./assets/preview.svg"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.2",
    "@earendil-works/pi-tui": ">=0.99.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.2",
    "@earendil-works/pi-tui": "^0.99.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "unbash": "^4.0.11"
  }
}
